{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.ts",
    "src/**/*.{ts,tsx}",
    "test/**/*.test.ts",
    "test/**/*.test-d.ts",
    "e2e/**/*.spec.ts",
    "test-support/otel/vitest-sdk.ts"
  ],
  "project": [
    "scripts/**/*.ts",
    "src/**/*.{ts,tsx,css}",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "test-support/otel/**/*.ts"
  ],
  "ignoreDependencies": ["@commitlint/cli", "@opentelemetry/exporter-trace-otlp-(grpc|http|proto)"],
  "ignoreBinaries": ["mise"]
}
